# ==============================================================================
# Faceless Shorts Automation Studio v2 — Environment Configuration
# Copy this file to .env and fill in your API keys
# ==============================================================================

# --- LLM Providers (Strictly English Story & Metadata Generation) ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

DEFAULT_LLM_PROVIDER=groq
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# --- Voiceover / TTS Engine ---
# Options: "qwen3" (Local CUDA bfloat16 emotional voice) or "edge" (Fast English neural draft)
DEFAULT_TTS_ENGINE=qwen3
EDGE_TTS_VOICE_MALE=en-US-ChristopherNeural
EDGE_TTS_VOICE_FEMALE=en-US-AvaNeural

# --- Multi-Day Slot Scheduler (Never Direct-Publish) ---
# Comma-separated 24h daily slots in SCHEDULE_TIMEZONE (12pm, 3pm, 6pm, 9pm -> next day)
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_DAILY_SLOTS=12:00,15:00,18:00,21:00
MIN_SCHEDULE_LEAD_MINUTES=20
MAX_DAYS_AHEAD=7
MAX_UPLOADS_PER_DAY=5

# --- Autonomous Automation Loop ---
AUTOMATION_COOLDOWN_SEC=45
MAX_RENDER_RETRIES=2
YOUTUBE_CATEGORY_ID=24

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
